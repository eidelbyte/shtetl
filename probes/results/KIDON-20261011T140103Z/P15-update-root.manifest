#onto shprun/foundations/F@new 43417940896163257
#made -
#tag zr-d59730be25da
#take -
#written 2026-10-11T14:08:31Z
#mode strict
#actions 15
#conflicts 1
/
    etc/
        group conflict 1
        hosts write /etc/hosts
        master.passwd write /etc/master.passwd
        passwd write /etc/passwd
        pwd.db write /etc/pwd.db
        rc.conf cp /etc/rc.conf
        spwd.db write /etc/spwd.db
        ..
    home/ cp /home
        probe/ cp /home/probe
            .cshrc cp /home/probe/.cshrc
            .login cp /home/probe/.login
            .login_conf cp /home/probe/.login_conf
            .mail_aliases cp /home/probe/.mail_aliases
            .mailrc cp /home/probe/.mailrc
            .profile cp /home/probe/.profile
            .shrc cp /home/probe/.shrc
            ..
        ..
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /etc/group changed on both sides
  base ({/etc/group}x)
  from ({/etc/group}y)
  onto ({/etc/group}z)
