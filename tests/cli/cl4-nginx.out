# containers/nginx.conf: a container's recipe, its layers merged
# layers, nearest last: shtetl.conf, common/web.conf, containers/nginx.conf
ver = [
    ">=15.1",  # shtetl.conf
    ">=15",  # common/web.conf
    "<16"  # containers/nginx.conf
]
pkg {
    sudo = true;  # shtetl.conf
    tmux = true;  # shtetl.conf
    apache24 = true;  # common/web.conf
    py311-certbot = true;  # common/web.conf
    nginx = true;  # containers/nginx.conf
}
datasets {
    tmp {}  # shtetl.conf
    var {}  # shtetl.conf
    "usr/local" {}  # shtetl.conf
    www {  # containers/nginx.conf
        readonly = true;  # containers/nginx.conf
    }
}
commands {
    certbot {  # common/web.conf
        "common/web.conf" = "sysrc certbot_enable=YES";
    }
    nginx {  # containers/nginx.conf
        "containers/nginx.conf" = "sysrc nginx_enable=YES";
    }
}
jailconf {
    "common/web.conf" = "allow.raw_sockets;";
    "containers/nginx.conf" = <<EOD
allow.sysvipc;
host.hostname = "nginx";
EOD
}
