# foundations/generic.conf: a foundation's recipe, its layers merged
# layers, nearest last: default.conf, foundations/generic.conf
pkg {
    sudo = true;  # default.conf
    tmux = true;  # default.conf
}
datasets {
    tmp {}  # default.conf
    var {}  # default.conf
    "usr/local" {  # default.conf
        compression = "zstd-9";  # foundations/generic.conf
    }
}
ver = [
    ">=15"  # foundations/generic.conf
]
src_branch = "releng/15.1";  # foundations/generic.conf
kernconf_file = "GENERIC";  # foundations/generic.conf
kernconf_lines = [
    "nooptions INVARIANTS\nnooptions WITNESS"  # foundations/generic.conf
]
buildopts = [
    "WITHOUT_LIB32=yes\nWITH_META_MODE=yes"  # foundations/generic.conf
]
patches {
    "github.com/eidelbyte/freebsd-patches" {  # foundations/generic.conf
        ref = "releng-15.1";  # foundations/generic.conf
    }
    "patches/generic" {}  # foundations/generic.conf
}
