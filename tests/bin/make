#!/bin/sh
# The make a roll runs, faked for the tests (tests/check_roll.c), as
# are the other programs in tests/bin: each call is logged to $FAKE_LOG,
# a line of the program's name and its words, so that the log holds the
# roll's calls in order. make's targets leave what the real ones would,
# where they would.
#
#   FAKE_KERNEL	the kernel installkernel installs: 1 (kernel, a.ko,
#		b.ko, debug files) or 2 (kernel, a.ko alike, b.ko gone,
#		c.ko new, no debug files)
#   FAKE_FAIL	the target, or the program, that fails
#   FAKE_SLEEP	the target that sleeps until it is killed

echo "make $*" >> "${FAKE_LOG:-/dev/null}"
D=
for a; do
	case $a in
	DESTDIR=*) D=${a#DESTDIR=} ;;
	esac
done
for t; do
	case $t in
	-*|*=*) continue ;;
	esac
	[ "$t" = "${FAKE_SLEEP:-}" ] && sleep 60
	[ "$t" = "${FAKE_FAIL:-}" ] && { echo "make: $t failed" >&2; exit 2; }
	case $t in
	buildworld|buildkernel)
		echo "$t" > "$MAKEOBJDIRPREFIX/$t"
		;;
	installworld)
		mkdir -p "$D/bin" "$D/sbin" "$D/libexec" "$D/boot"
		echo world > "$D/bin/sh"
		# what installworld backs up, where there is one to back up
		for f in sbin/init:sbin/init.bak \
		    libexec/ld-elf.so.1:libexec/ld-elf.so.1.old \
		    boot/loader:boot/loader.old; do
			[ -f "$D/${f%%:*}" ] && cp "$D/${f%%:*}" "$D/${f#*:}"
			echo "${f%%:*}" > "$D/${f%%:*}"
		done
		;;
	installkernel)
		k=$D/boot/kernel
		mkdir -p "$k"
		echo "kernel ${FAKE_KERNEL:-1}" > "$k/kernel"
		echo a > "$k/a.ko"
		if [ "${FAKE_KERNEL:-1}" = 1 ]; then
			echo b > "$k/b.ko"
			mkdir -p "$D/usr/lib/debug/boot/kernel"
			echo debug > "$D/usr/lib/debug/boot/kernel/kernel.debug"
		else
			echo c > "$k/c.ko"
		fi
		;;
	distribution)
		mkdir -p "$D/etc"
		echo dist > "$D/etc/rc.conf"
		;;
	esac
done
exit 0
