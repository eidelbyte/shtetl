#!/bin/sh
# pkg, faked for the tests (tests/bin/make says how the fakes log and
# fail): pkg -c ROOT ... logged, and whether ROOT has a resolv.conf.
[ "$1" = -c ] && [ -f "$2/etc/resolv.conf" ] && r=" (resolv.conf)"
echo "pkg $*${r:-}" >> "${FAKE_LOG:-/dev/null}"
[ "${FAKE_FAIL:-}" = pkg ] && { echo "pkg: failed" >&2; exit 1; }
exit 0
